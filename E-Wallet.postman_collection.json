{
	"info": {
		"_postman_id": "e-wallet-collection",
		"name": "E-Wallet Microservices",
		"description": "Complete Postman collection for E-Wallet microservices APIs with test scripts and variables",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "e-wallet"
	},
	"item": [
		{
			"name": "Customer Service",
			"item": [
				{
					"name": "1. Onboard Customer",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 or 200\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([201, 200]);",
									"});",
									"",
									"pm.test(\"Response has success field\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('success');",
									"});",
									"",
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.id) {",
									"        pm.collectionVariables.set(\"customerId\", jsonData.data.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"John Doe\",\n    \"phoneNumber\": \"1234567890\",\n    \"email\": \"john.doe@example.com\"\n}"
						},
						"url": {
							"raw": "{{customerServiceUrl}}/customer/onboard",
							"host": [
								"{{customerServiceUrl}}"
							],
							"path": [
								"customer",
								"onboard"
							]
						},
						"description": "Onboards a new customer. Creates customer record and sends OTP to phone and email."
					},
					"response": []
				},
				{
					"name": "2. Verify OTP",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"OTP verified successfully\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phoneNumber\": \"1234567890\",\n    \"otp\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{customerServiceUrl}}/customer/verifyOtp",
							"host": [
								"{{customerServiceUrl}}"
							],
							"path": [
								"customer",
								"verifyOtp"
							]
						},
						"description": "Verifies the OTP sent to customer. Check logs for OTP value."
					},
					"response": []
				},
				{
					"name": "3. Set Credentials",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Credentials set successfully\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"});",
									"",
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.customerAccounts) {",
									"        var accounts = jsonData.data.customerAccounts;",
									"        if (accounts && accounts.length > 0 && accounts[0].accountNumber) {",
									"            pm.collectionVariables.set(\"accountNumber\", accounts[0].accountNumber);",
									"        }",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phoneNumber\": \"1234567890\",\n    \"password\": \"password123\",\n    \"mpin\": \"1234\"\n}"
						},
						"url": {
							"raw": "{{customerServiceUrl}}/customer/setCredentials",
							"host": [
								"{{customerServiceUrl}}"
							],
							"path": [
								"customer",
								"setCredentials"
							]
						},
						"description": "Sets password and MPIN for the customer. Account is created automatically."
					},
					"response": []
				},
				{
					"name": "4. Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Login successful\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.message).to.include(\"successful\");",
									"});",
									"",
									"pm.test(\"Response contains customer data\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('id');",
									"    pm.expect(jsonData.data).to.have.property('name');",
									"    pm.expect(jsonData.data).to.not.have.property('password');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phoneNumber\": \"1234567890\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{customerServiceUrl}}/customer/login",
							"host": [
								"{{customerServiceUrl}}"
							],
							"path": [
								"customer",
								"login"
							]
						},
						"description": "Authenticates customer using phone number and password. Returns customer data without password."
					},
					"response": []
				},
				{
					"name": "5. Get Customer by Phone",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
