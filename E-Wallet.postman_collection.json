								"{{customerServiceUrl}}"
							],
							"path": [
								"customer",
								"{{phoneNumber}}"
							]
						},
						"description": "Retrieves customer details by phone number."
					},
					"response": []
				},
				{
					"name": "6. Get Customer Account",
					"event": [
						{
							"listen": "test",
