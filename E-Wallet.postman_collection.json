							]
						},
						"description": "Retrieves customer account details by account number."
					},
					"response": []
				},
				{
					"name": "7. Update Balance",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Balance updated successfully\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"accountNumber\": \"{{accountNumber}}\",\n    \"amount\": 1000.00\n}"
						},
						"url": {
							"raw": "{{customerServiceUrl}}/customer/update-balance",
							"host": [
								"{{customerServiceUrl}}"
							],
							"path": [
								"customer",
								"update-balance"
							]
						},
						"description": "Updates the balance of a customer account. Use positive amount to add, negative to deduct."
					},
					"response": []
				},
				{
					"name": "8. Load Balance",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Balance loaded successfully\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"});",
									"",
									"pm.test(\"Response contains account data\", function () {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data) {",
									"        pm.expect(jsonData.data).to.have.property('balance');",
									"        pm.expect(jsonData.data).to.have.property('accountNumber');",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phoneNumber\": \"{{phoneNumber}}\",\n    \"amount\": 1000.00\n}"
						},
						"url": {
							"raw": "{{customerServiceUrl}}/customer/load-balance",
							"host": [
								"{{customerServiceUrl}}"
							],
							"path": [
								"customer",
								"load-balance"
							]
						},
						"description": "Loads/adds amount to customer account balance using phone number. Customer must be ACTIVE."
					},
					"response": []
				}
			],
			"description": "APIs for customer management including onboarding, OTP verification, credentials, and account management."
		},
